# העתיקו לקובץ .env (לפיתוח מקומי) או הגדירו ב-Railway.
# לעולם אל תעלו את .env ל-GitHub.

# ===== חובה =====
DATABASE_URL=postgres://user:password@host:5432/dbname
OPENAI_API_KEY=
WHAPI_TOKEN=

# ===== אבטחה (מומלץ מאוד) =====
# טקסט סודי ארוך. בכתובת ה-Webhook ב-Whapi:
# https://<השרת>/webhook?token=<WEBHOOK_SECRET>
WEBHOOK_SECRET=

# ===== מנהלים, מאמנים ולידים =====
# מספרים מופרדים בפסיק, למשל: 0501234567,0521234567
MANAGER_PHONES=
COACH_PHONES=
# למי נשלחים לידים (אם ריק — לכל MANAGER_PHONES)
CLUB_MANAGER_PHONE=
# שמות צוות לדיווחים: 0501234567:שם,0521234567:שם
STAFF_NAMES=

# ===== העברה לנציג אנושי =====
# כשמישהו מהצוות עונה ידנית ללקוח, הבוט שותק מולו למשך X שעות
HUMAN_HANDOFF_ENABLED=true
HANDOFF_PAUSE_HOURS=12

# ===== בדיקות =====
# מספרים שמקבלים את בוט הלקוחות (גם אם הם מנהלים) ויכולים לכתוב "איפוס שיחה"
TEST_PHONES=

# ===== אופציונלי =====
OPENAI_MODEL=gpt-4o-mini
PORT=3000
